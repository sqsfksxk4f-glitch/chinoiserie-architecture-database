{
  "manifest_version": 3,
  "name": "自动刷新 - 防代理掉线",
  "version": "1.0",
  "description": "每20分钟自动刷新网页，防止代理掉线",
  "permissions": ["alarms", "tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "自动刷新"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
